# Qwen2API Configuration

# OpenAI API Keys for authentication (comma-separated if multiple)
API_KEY=sk-user-your-secret-key

# Storage Mode: "file" (local data/data.json) or "redis"
DATA_SAVE_MODE=file

# Initial Accounts (format: email,password or email,password,cookie)
# Or configure directly via the web admin panel or data/data.json
ACCOUNTS=

# Server Bind Address (use 0.0.0.0 for Docker / Coolify VPS)
LISTEN_ADDRESS=0.0.0.0
SERVICE_PORT=3000

# Upstream Qwen proxy URL
QWEN_CHAT_PROXY_URL=https://chat.qwen.ai

# Optional HTTP/SOCKS5 proxy for upstream requests
PROXY_URL=

# Token auto-refresh configuration
AUTO_REFRESH=true
AUTO_REFRESH_INTERVAL=21600

# Concurrency & Performance
BATCH_LOGIN_CONCURRENCY=3
SIMPLE_MODEL_MAP=false
SEARCH_INFO_MODE=text
OUTPUT_THINK=false

# Logging & Resource Optimization (Keep INFO and DEBUG_MODE=false for low VPS CPU/Disk usage)
LOG_LEVEL=INFO
DEBUG_MODE=false
ENABLE_FILE_LOG=false

# Cache & Cleanup
CHAT_CLEANUP_MODE=0
CACHE_MODE=default
